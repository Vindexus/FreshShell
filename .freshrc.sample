# freshshell.com
#
# Examples:
#
#   fresh twe4ked/dotfiles shell/functions/\*
#   fresh jasoncodes/dotfiles shell/aliases/rails.sh
#   fresh jasoncodes/dotfiles config/tmux.conf --file
#
# See http://freshshell.com/readme for documentation.

fresh freshshell/fresh bin/fresh --bin

# --- Environment & runtime ---
fresh Vindexus/FreshShell shell/env.sh

# --- Aliases ---
fresh Vindexus/FreshShell shell/aliases/\*

# --- Functions ---
fresh Vindexus/FreshShell shell/functions/\*

# --- Login banner (sourced last) ---
fresh Vindexus/FreshShell shell/startup.sh

# --- Git config (aliases via [include] in ~/.gitconfig) ---
fresh Vindexus/FreshShell git/aliases.gitconfig --file ~/.gitconfig.fresh

# --- Agent instructions ---
fresh Vindexus/FreshShell agents/AGENTS.md --file ~/.claude/CLAUDE.md

# --- Executables (bin/) ---
fresh Vindexus/FreshShell bin/cob --bin
fresh Vindexus/FreshShell bin/block-agent-push --bin

fresh foobacca/dotfiles shell/aliases-dir